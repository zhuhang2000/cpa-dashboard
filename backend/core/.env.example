# ==========================================
# 基础服务配置
# ==========================================
LISTEN=127.0.0.1
PORT=18400
SITE_NAME=API 控制台
CURRENCY_SYMBOL=$
PUBLIC_API_BASE=
TZ_OFFSET_MINUTES=480
DATA_DIR=../data
FRONTEND_DIR=../../frontend/dist
TRUST_PROXY=false
COOKIE_SECURE=auto
SESSION_DAYS=7
ALLOW_REGISTER=true
MAX_KEYS_PER_USER=10
MIN_BALANCE_TO_CALL=0
KEY_PREFIX=sk-

# ==========================================
# CPA (API 代理对接)
# ==========================================
CPA_BASE_URL=http://127.0.0.1:8317
CPA_MANAGEMENT_KEY=
CPA_SYNC_KEYS=true
CPA_TIMEOUT_SECONDS=8

# ==========================================
# CPA Manager Plus (使用量数据库同步)
# ==========================================
CPAMP_USAGE_DB=/opt/services/cpa-manager-plus/data/usage.sqlite
CPAMP_SYNC_INTERVAL_SECONDS=15
CPAMP_BATCH_SIZE=1000

# ==========================================
# 多 CPA 节点（可选）
# ==========================================
# 上面的 CPA_BASE_URL / CPA_MANAGEMENT_KEY / CPAMP_USAGE_DB 是 1 号节点。
# 再加节点时从 2 开始编号，三项都要填；每个节点要有自己的 CPAMP 实例和用量库。
# 密钥会同步到每个节点，用量逐个节点读取后统一扣费；官方价格取自 1 号节点的 CPAMP。
# NODE2_CPA_BASE_URL=http://10.0.0.2:8317
# NODE2_CPA_MANAGEMENT_KEY=
# NODE2_CPAMP_USAGE_DB=/opt/services/cpamp-node2/data/usage.sqlite

# ==========================================
# 节点分流（可选，配合 deploy/cpa-router/）
# ==========================================
# nginx 分流控制接口，只监听本机。留空时「节点分流」页面的设置只保存、不生效。
# ROUTER_CONTROL_URL=http://127.0.0.1:18490
# 与 /etc/nginx/cpa-router-token.conf 里的令牌相同，生成：openssl rand -hex 24
# ROUTER_CONTROL_TOKEN=

# ==========================================
# 计费与定价
# ==========================================
USE_CPAMP_PRICES=true
CPAMP_PRICE_DISCOUNT=1.0
DEFAULT_INPUT_PRICE=0
DEFAULT_OUTPUT_PRICE=0
BILL_FAILED_REQUESTS=false

# ==========================================
# 支付与充值 (易支付 / EPay)
# ==========================================
PAYMENT_PRESETS=10,30,50,100,200,500
PAYMENT_MIN_AMOUNT=1
PAYMENT_MAX_AMOUNT=10000
PAYMENT_CREDIT_RATIO=1.0

EPAY_ENABLED=false
EPAY_GATEWAY=
EPAY_PID=
EPAY_KEY=
EPAY_CHANNELS=alipay,wxpay
EPAY_SITE_URL=
